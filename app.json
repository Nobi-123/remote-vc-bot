{
  "name": "VC Multi Assistant Bot",
  "description": "A Telegram multi-assistant VC bot with PyTgCalls, sudo system, silence mode, and audio streaming.",
  "repository": "https://github.com/your-repo-link",
  "logo": "https://te.legra.ph/file/9c0e0c83db0d4d4a713fa.jpg",
  "keywords": ["telegram", "vc", "music", "assistant", "pytgcalls", "pyrogram"],
  "env": {
    "API_ID": {
      "description": "Your Telegram API_ID from my.telegram.org",
      "required": true
    },
    "API_HASH": {
      "description": "Your Telegram API_HASH from my.telegram.org",
      "required": true
    },
    "BOT_TOKEN": {
      "description": "The token of your bot from @BotFather",
      "required": true
    },
    "OWNER_ID": {
      "description": "Owner user ID (only this user can add or remove sudo users)",
      "required": true
    }
  },
  "buildpacks": [
    {
      "url": "heroku/python"
    }
  ],
  "formation": {
    "worker": {
      "quantity": 1,
      "size": "Standard-1X"
    }
  }
}